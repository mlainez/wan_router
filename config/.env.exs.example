import Config

# Template for config/.env.exs (which is gitignored). Copy this file to
# config/.env.exs and fill in real values:
#
#     cp config/.env.exs.example config/.env.exs
#
# WIFI_SSID / WIFI_PSK configure wlan0 as a secondary WAN (WiFi client).
# Leave them out and wlan0 is left unconfigured (cellular-only).
System.put_env("WIFI_SSID", "your-network-name")
System.put_env("WIFI_PSK", "your-passphrase")
